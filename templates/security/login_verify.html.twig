{% extends 'base.html.twig' %}

{% block title %}Saisie du code{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-5">
        <div class="col-md-5 col-lg-4">
            <h1 class="h3 mb-3 fw-normal text-center">Code de vérification</h1>
            <p class="text-muted text-center small">
                Un code à 6 chiffres a été envoyé à <strong>{{ pendingEmail }}</strong>.
            </p>

            {% if email_login_dev_code is defined and email_login_dev_code != '' %}
                <div class="alert alert-warning small mb-3" role="status">
                    Mode développement : vous pouvez saisir le code fixe <code class="user-select-all">{{ email_login_dev_code }}</code>
                    (variable <code>EMAIL_LOGIN_DEV_CODE</code>).
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login_verify_submit') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('email_login_verify') }}">

                <div class="mb-3">
                    <label for="code" class="form-label">Code</label>
                    <input type="text" name="code" id="code" class="form-control text-center fs-4" inputmode="numeric"
                           pattern="[0-9\s]*" maxlength="12" required autofocus autocomplete="one-time-code"
                           placeholder="000000">
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe" value="1">
                    <label class="form-check-label" for="rememberMe">Se souvenir de moi sur cet appareil</label>
                </div>

                <button class="btn btn-primary w-100" type="submit">Valider</button>

                <p class="text-center mt-3 mb-0">
                    <a href="{{ path('app_login') }}">← Changer d’adresse e-mail</a>
                </p>
            </form>
        </div>
    </div>
{% endblock %}
