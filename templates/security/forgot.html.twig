{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublie{% endblock %}

{% block body %}
    <section class="auth-shell">
        <div class="auth-card">
            <h1 class="auth-title">Mot de passe oublie</h1>
            <p class="auth-subtitle">Entrez votre email pour recevoir un lien de reinitialisation.</p>

            <form method="post" novalidate>
                <div class="mb-4">
                    <label for="forgotEmail" class="form-label">Email</label>
                    <input id="forgotEmail" type="email" name="email" class="form-control" required>
                </div>
                <button class="btn btn-primary w-100">Envoyer le lien</button>
            </form>

            <div class="text-center mt-3">
                <a href="{{ path('app_login') }}" class="text-decoration-none">Retour a la connexion</a>
            </div>
        </div>
    </section>
{% endblock %}
