<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}OVH Manager{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% block stylesheets %}
        {% if encore_entry_exists('app') %}
            {{ encore_entry_link_tags('app') }}
        {% endif %}
    {% endblock %}
</head>
<body class="{% block body_class %}app-shell{% endblock %}">
<div class="app-bg-overlay"></div>

<header class="app-header border-bottom border-light-subtle">
    <div class="container d-flex align-items-center justify-content-between py-3">
        <a href="{{ path('app_home') }}" class="text-decoration-none d-flex align-items-center gap-2">
            <span class="brand-dot"></span>
            <span class="brand-text">OVH Manager</span>
        </a>

        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">Deconnexion</a>
        {% endif %}
    </div>
</header>

<main class="{% block container_class %}container py-4 py-lg-5 app-content{% endblock %}">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}
    {% if encore_entry_exists('app') %}
        {{ encore_entry_script_tags('app') }}
    {% endif %}
{% endblock %}
</body>
</html>
